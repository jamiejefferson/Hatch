{
  "manifest_version": 3,
  "name": "Hatch sign-in",
  "version": "1.0.0",
  "description": "Sends your sign-in for the site in this tab to Hatch, so Hatch never asks for your Mac password.",
  "key": "",
  "permissions": [
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*/*"
  ],
  "action": {
    "default_title": "Send this sign-in to Hatch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
