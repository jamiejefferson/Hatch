{
  "name": "hatch",
  "version": "0.1.12",
  "private": true,
  "description": "A stripped-down macOS browser that any MCP-capable agent can drive",
  "license": "MIT",
  "repository": "github:jamiejefferson/hatch",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "spike": "electron spikes/run.mjs",
    "package": "electron-vite build && electron-builder --mac",
    "release": "pnpm package && sh build/release.sh"
  },
  "devDependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
